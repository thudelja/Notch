<Window x:Class="SDBackup.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch Settings"
        Width="580"
        Height="760"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- DataContext: SDBackup.Windows.AppModel. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

            <!-- ============================================================ Projects folder -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Projects folder" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Change…" Margin="12,0,0,0"
                                Command="{Binding ChangeProjectsFolderCommand}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Settings.ProjectsFolder}"
                                   ToolTip="{Binding Settings.ProjectsFolder}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,10,0,0">
                        Photos: 2026 › Photo › 11 November › 02.11.2026 Name › Camera<LineBreak />
                        Videos: 2026 › Video › 11 November › 02.11.2026 Name › Media › Camera, plus Project, Assets and Export folders.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============================================================ Move a year -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Move a year to another drive" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsMigrating, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Stop"
                                    Command="{Binding CancelMigrationCommand}" />
                            <StackPanel DataContext="{Binding MigrationStatus}">
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Subtitle}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Bar}" Margin="0,10,0,6" DataContext="{Binding MigrationStatus}"
                                     Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                        <TextBlock Style="{StaticResource CaptionText}" DataContext="{Binding MigrationStatus}" Text="{Binding Line1Left}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsMigrating, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Style="{StaticResource CaptionText}" Text="There are no year folders in the projects folder yet."
                                   Visibility="{Binding HasYears, Converter={StaticResource BoolToCollapsed}}" />
                        <DockPanel Visibility="{Binding HasYears, Converter={StaticResource BoolToVisible}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Move to drive…"
                                    Command="{Binding MoveYearCommand}" />
                            <TextBlock Style="{StaticResource BodyText}" Text="Year" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Style="{StaticResource PickerBox}" Width="110" HorizontalAlignment="Left" MinHeight="32"
                                      ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,12,0,0"
                               Text="Moves the whole year (photos, videos and editing projects) to a folder you choose, for example on your SSD, keeping the same structure. Each file is verified before it’s deleted from this PC. Moved projects keep working from the drive; new projects still go to this PC." />
                </StackPanel>
            </Border>

            <!-- ============================================================ Cards -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Cards" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoImport}">
                        <TextBlock Style="{StaticResource BodyText}" Text="Ask for a project as soon as a card is inserted" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.DetectAnyRemovable}">
                        <TextBlock Style="{StaticResource BodyText}" Text="Also import from USB flash drives and other removable drives" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,4,0,0" Text="{Binding Settings.DetectionExplanation}" />
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,8,0,0"
                               Text="Tip: to stop Windows' own AutoPlay prompt appearing too, set Memory card to “Take no action” in Settings › Bluetooth &amp; devices › AutoPlay." />
                </StackPanel>
            </Border>

            <!-- ============================================================ Safety -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Safety" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.VerifyCopies}">
                        <TextBlock Style="{StaticResource BodyText}" Text="Verify every copied file" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,0,0,8"
                               Text="Reads each copy back and compares its SHA-256 checksum with the original. Slightly slower, strongly recommended." />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.EjectWhenDone}">
                        <TextBlock Style="{StaticResource BodyText}" Text="Eject the card when the import finishes" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ============================================================ After importing -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="After importing" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource PickerBox}" Width="190"
                                  AutomationProperties.Name="Open new photos in"
                                  ItemsSource="{Binding Settings.PhotoAppChoices}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.PhotoApp, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource BodyText}" Text="Open new photos in" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,8,0,0" Text="{Binding Settings.PhotoAppExplanation}" />
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding Settings.PhotoAppNote}"
                               Visibility="{Binding Settings.PhotoAppNote, Converter={StaticResource TextToVisible}}" />
                </StackPanel>
            </Border>

            <!-- ============================================================ General -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="General" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}">
                        <TextBlock Style="{StaticResource BodyText}" Text="Start with Windows" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.NotificationsEnabled}">
                        <TextBlock Style="{StaticResource BodyText}" Text="Show notifications" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SubtleButton}" Content="Open log" Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SubtleButton}" Content="Clear recent" Command="{Binding ClearHistoryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ Memory -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Memory" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButton}" Content="Forget imported files…" Command="{Binding ForgetImportedFilesCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SubtleButton}" Content="Forget camera names" Command="{Binding ForgetCameraNamesCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,10,0,0"
                               Text="Notch remembers which files of each card were imported, so a card you insert again only offers new files. It also remembers the folder name you gave each camera." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
