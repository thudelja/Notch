<Window x:Class="SDBackup.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SDBackup.App"
        xmlns:local="clr-namespace:SDBackup.App"
        Title="Notch"
        Width="404"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <!--
        The panel that opens from the notification-area icon, styled like Windows 11 Quick Settings.
        DataContext: SDBackup.Windows.AppModel.
    -->
    <Grid Margin="12">
        <!-- The shadow sits on its own layer so it doesn't blur the text. -->
        <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
            </Border.Effect>
        </Border>

        <Border x:Name="Root" CornerRadius="8" Padding="12" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceStrokeBrush}">
            <DockPanel>

                <!-- ============================================================ Footer -->
                <DockPanel DockPanel.Dock="Bottom" Margin="4,2,4,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{l:T 'Quit Notch'}"
                            Command="{Binding QuitCommand}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Notch.png" Width="16" Height="16" Margin="0,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Style="{StaticResource SmallText}" Text="Notch" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- The window is capped at the screen's height (see FlyoutWindow.Reposition); the rest scrolls. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>

                <!-- ============================================================ Quick settings -->
                <UniformGrid Columns="3">
                    <ToggleButton Style="{StaticResource QuickToggle}" Tag="{l:T 'Auto import'}" Margin="0,0,6,10"
                                  IsChecked="{Binding Settings.AutoImport}"
                                  ToolTip="{l:T 'Read cards as soon as they’re inserted and ask which project they belong to'}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource QuickToggle}" Tag="{l:T 'Verify'}" Margin="3,0,3,10"
                                  IsChecked="{Binding Settings.VerifyCopies}"
                                  ToolTip="{l:T 'Check every copy against the original (SHA-256)'}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEA18;" />
                    </ToggleButton>
                    <ToggleButton x:Name="EjectToggle" Style="{StaticResource QuickToggle}" Tag="{l:T 'Auto eject'}" Margin="6,0,0,10"
                                  IsChecked="{Binding Settings.EjectWhenDone}"
                                  ToolTip="{l:T 'Eject the card when its import finishes'}">
                        <Path Data="{StaticResource EjectGeometry}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, ElementName=EjectToggle}" />
                    </ToggleButton>

                    <Button Style="{StaticResource QuickButton}" Tag="{Binding ProjectsFolderName}" Margin="0,0,6,10"
                            Command="{Binding OpenProjectsFolderCommand}" ToolTip="{l:T 'Open the projects folder'}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" />
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Tag="{l:T 'Settings'}" Margin="3,0,3,10"
                            Command="{Binding OpenSettingsCommand}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Tag="{l:T 'Log'}" Margin="6,0,0,10"
                            Command="{Binding OpenLogCommand}" ToolTip="{l:T 'Open the import log'}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" />
                    </Button>
                </UniformGrid>

                <!-- ============================================================ Import: pick a project per shoot day -->
                <Border Style="{StaticResource Card}" Visibility="{Binding CurrentDraft, Converter={StaticResource NotNullToVisible}}">
                    <StackPanel DataContext="{Binding CurrentDraft}">
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0"
                                    Background="{DynamicResource AccentBrush}">
                                <Path Data="{StaticResource SdCardGeometry}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource AccentForegroundBrush}" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource CaptionText}"
                                       Text="{Binding DataContext.MoreWaitingText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource WrappedCaptionText}" Text="{Binding Summary}" />
                            </StackPanel>
                        </DockPanel>

                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" Text="{Binding Counts}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding DateText}" />
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                               Text="{Binding Weekday}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ComboBox Style="{StaticResource PickerBox}" Margin="0,6,0,0" MinHeight="32"
                                                      ItemsSource="{Binding Options}"
                                                      SelectedValuePath="Choice"
                                                      SelectedValue="{Binding Choice, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- A new multi-day shoot: its name, and this day's project in it -->
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsNewShoot, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Style="{StaticResource SmallText}" Text="{l:T 'Multi-day shoot, e.g. AMD Koledar 2026'}" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource FieldBox}" AutomationProperties.Name="{l:T 'Multi-day shoot'}"
                                                         Text="{Binding ShootName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource SmallText}" Text="{l:T 'Name of this day’s project, e.g. the model'}" Margin="0,8,0,4" />
                                                <TextBox Style="{StaticResource FieldBox}" AutomationProperties.Name="{l:T 'Name of this day’s project'}"
                                                         Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!-- A new project, on its own or in a multi-day shoot -->
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding AsksForName, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Style="{StaticResource SmallText}" Text="{l:T 'Name of the new project'}" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource FieldBox}" AutomationProperties.Name="{l:T 'Name of the new project'}"
                                                         Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!-- Where a new project's photos and videos go: "Photos → Projects  [Change…]" -->
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowsPhotoPlace, Converter={StaticResource BoolToVisible}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="10,3" FontSize="12" Content="{l:T 'Change…'}"
                                                        ToolTip="{l:T 'Choose the folder this project’s photos go in'}"
                                                        AutomationProperties.Name="{l:T 'Change where the photos go'}" Command="{Binding ChangePhotosCommand}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Margin="0,0,4,0"
                                                        ToolTip="{l:T 'Back to the default folder'}" AutomationProperties.Name="{l:T 'Photos back to the default folder'}"
                                                        Visibility="{Binding HasChosenPhotoFolder, Converter={StaticResource BoolToVisible}}"
                                                        Command="{Binding ResetPhotosCommand}">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE7A7;" />
                                                </Button>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="12" Width="18" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="&#xE91B;" />
                                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding PhotoPlaceText}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowsVideoPlace, Converter={StaticResource BoolToVisible}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="10,3" FontSize="12" Content="{l:T 'Change…'}"
                                                        ToolTip="{l:T 'Choose the folder this project’s videos go in'}"
                                                        AutomationProperties.Name="{l:T 'Change where the videos go'}" Command="{Binding ChangeVideosCommand}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Margin="0,0,4,0"
                                                        ToolTip="{l:T 'Back to the default folder'}" AutomationProperties.Name="{l:T 'Videos back to the default folder'}"
                                                        Visibility="{Binding HasChosenVideoFolder, Converter={StaticResource BoolToVisible}}"
                                                        Command="{Binding ResetVideosCommand}">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE7A7;" />
                                                </Button>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="12" Width="18" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="&#xE714;" />
                                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding VideoPlaceText}" />
                                            </DockPanel>

                                            <!-- A day in an open multi-day shoot: hold to finish the shoot -->
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsInShoot, Converter={StaticResource BoolToVisible}}">
                                                <local:HoldButton HorizontalAlignment="Left" Padding="10,4" FontSize="12"
                                                                  Text="{Binding FinishShootTitle}" AutomationProperties.Name="{Binding FinishShootTitle}"
                                                                  Command="{Binding FinishShootCommand}"
                                                                  Visibility="{Binding CanFinishShoot, Converter={StaticResource BoolToVisible}}" />
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ShootFinished, Converter={StaticResource BoolToVisible}}">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessBrush}" Text="&#xE73E;" />
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Text="{Binding ShootFinishedText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        <StackPanel Visibility="{Binding HasCameras, Converter={StaticResource BoolToVisible}}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource CaptionText}" FontWeight="SemiBold" Text="{l:T 'Camera folders'}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Cameras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBox DockPanel.Dock="Right" Width="130" Style="{StaticResource FieldBox}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Label}" />
                                                <TextBlock Style="{StaticResource SmallText}" Text="{Binding CountText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,0,0,10" Text="{Binding BlockingReason}"
                                   Visibility="{Binding BlockingReason, Converter={StaticResource NotNullToVisible}}" />

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T 'Import'}" IsDefault="True"
                                    Command="{Binding ImportCommand}" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource SubtleButton}" Content="{l:T 'Not now'}"
                                    Command="{Binding NotNowCommand}" ToolTip="{l:T 'Close without importing. Use Import next to the card later.'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================ Running tasks -->
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                                Command="{Binding CancelCommand}" ToolTip="{l:T 'Cancel'}">
                                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE711;" />
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Subtitle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource Bar}" Margin="0,10,0,8"
                                                 Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" Text="{Binding Line1Right}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Line1Left}" />
                                    </DockPanel>
                                    <DockPanel Visibility="{Binding Line2Left, Converter={StaticResource TextToVisible}}">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" Text="{Binding Line2Right}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Line2Left}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SmallText}" Margin="0,2,0,0" Text="{Binding CurrentFile}"
                                               Visibility="{Binding CurrentFile, Converter={StaticResource TextToVisible}}" />
                                    <TextBlock Style="{StaticResource WrappedCaptionText}" Margin="0,4,0,0" Text="{Binding Note}"
                                               Visibility="{Binding Note, Converter={StaticResource TextToVisible}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============================================================ Idle -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowIdle, Converter={StaticResource BoolToVisible}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AutoImport}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="14" Foreground="{DynamicResource OnStatusBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.AutoImport}" Value="False">
                                                <Setter Property="Text" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TitleText}" Text="{Binding IdleTitle}" />
                            <TextBlock Style="{StaticResource WrappedCaptionText}" Text="{Binding IdleSubtitle}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============================================================ Cards -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Cards'}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{l:T 'No cards inserted'}"
                                   Visibility="{Binding HasCards, Converter={StaticResource BoolToCollapsed}}" />
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="{StaticResource SdCardGeometry}" Width="13" Height="13" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                                Command="{Binding EjectCommand}" IsEnabled="{Binding CanEject}" ToolTip="{l:T 'Eject'}">
                                            <Path Data="{StaticResource EjectGeometry}" Width="11" Height="11" Stretch="Uniform"
                                                  Fill="{DynamicResource TextPrimaryBrush}" />
                                        </Button>
                                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SubtleButton}" Content="{l:T 'Import'}" Padding="10,3"
                                                    Command="{Binding ImportCommand}"
                                                    Visibility="{Binding CanImport, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding StatusText}"
                                                       Visibility="{Binding CanImport, Converter={StaticResource BoolToCollapsed}}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================================ Recent -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Recent'}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{l:T 'Open the folder'}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Width="26" Margin="0,0,6,0"
                                                       VerticalAlignment="Top" Padding="0,2,0,0"
                                                       Text="{Binding Outcome, Converter={StaticResource OutcomeGlyph}}"
                                                       Foreground="{Binding Outcome, Converter={StaticResource OutcomeBrush}}" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" Text="{Binding When}" />
                                                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource WrappedCaptionText}" Text="{Binding Summary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
