<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Notch tray app for Windows 10 and 11. Build and install with windows/build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Notch</AssemblyName>
    <RootNamespace>SDBackup.App</RootNamespace>
    <ApplicationIcon>Assets\Notch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Notch</AssemblyTitle>
    <!-- Single-file publishing (build.ps1). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons and logo: generated by branding/make_icons.py. -->
    <Resource Include="Assets\Tray.ico" />
    <Resource Include="Assets\TrayAttention.ico" />
    <Resource Include="Assets\Notch.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDBackup.Core\SDBackup.Core.csproj" />
    <ProjectReference Include="..\SDBackup.Windows\SDBackup.Windows.csproj" />
  </ItemGroup>

</Project>
